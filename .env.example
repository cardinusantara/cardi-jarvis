# Salin ke .env, lalu isi. Semua opsional — tanpa file ini pun aplikasi jalan,
# hanya saja suaranya memakai Web Speech API bawaan Chrome.

# Suara ElevenLabs. Kosongkan untuk memakai fallback browser.
ELEVENLABS_API_KEY=
# Voice ID. Default "Rachel" (21m00Tcm4TlvDq8ikWAM) tersedia di semua akun.
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Bahasa untuk STT dan TTS (kode ISO-639-1).
LANGUAGE=id

# Model Claude.
MODEL=claude-sonnet-5

# Direktori kerja agent. Claude berjalan tanpa konfirmasi izin, jadi arahkan
# ke folder kerja — jangan ke root drive.
AGENT_CWD=

PORT=8787
WEB_ORIGIN=http://localhost:5173
